# 路径相对于 config.sh；仅覆盖本机需要调整的设置。
PROJECT=../llvm-project
SUITE=../llvm-test-suite
# SPEC2017_ROOT=../cpu2017

# WORK=.
# RESULTS=results/my-experiment
# COMMITS=commits.list
# PASS_CPU=0
# COLLECTOR_CPU=2
# PREPARE_JOBS=16
# BPF_CLANG=clang
# CRIU_BIN=criu
# CRIU_CLIENT=checkpoint/criu.py
# CRIU_SOCKET=build/criu.sock

